// 统一结果区：列表视图（42px 行 + 分组标题）与大图标网格视图，空闲/搜索双态互通
import { Theme } from "../styles/tokens.slint";
import { Icon, Squircle, Badge } from "widgets.slint";
import { ResultItem, ResultRow, GridSection } from "types.slint";
import { ListView, ScrollView } from "std-widgets.slint";

export component ResultPane inherits Rectangle {
    in property <[ResultRow]> rows;
    in property <[ResultItem]> items;
    in property <[GridSection]> sections;
    in property <string> view-mode: "list";
    in property <int> selected: 0;
    in property <length> selected-y: 0px;
    in property <length> selected-h: 42px;
    in property <string> query;
    in property <bool> smart: false;
    in property <string> empty-text: "";
    // 「双击条目立即执行」开关（设置页 · 常规）。关掉后双击只等于选中，
    // 不再直接调起系统默认程序 —— 之前这个开关只写进配置文件，界面根本不看它。
    in property <bool> dbl-launch: true;
    out property <int> grid-cols: Math.max(1, Math.floor((root.width - 32px + 8px) / 123px));
    // 设计稿 .icon-card-item 内容高 = padding 12 + glyph 36 + margin 6 + title 16
    //   + badge(margin 4 + 14) + padding 10 = 98；.items-icon-grid { gap: 8px } → 行距 106
    out property <length> cell-height: 106px;
    callback select(int);
    callback activate(int);
    callback context(int, length, length);

    public function ensure-visible() {
        if (root.view-mode == "grid") {
            if (root.selected-y < -grid.content-y) {
                grid.content-y = -root.selected-y;
            } else if (root.selected-y + root.selected-h > -grid.content-y + grid.visible-height) {
                grid.content-y = -(root.selected-y + root.selected-h - grid.visible-height);
            }
        } else {
            if (root.selected-y < -list.content-y) {
                list.content-y = -root.selected-y;
            } else if (root.selected-y + root.selected-h > -list.content-y + list.visible-height) {
                list.content-y = -(root.selected-y + root.selected-h - list.visible-height);
            }
        }
    }

    public function scroll-top() {
        list.content-y = 0px;
        grid.content-y = 0px;
    }

    clip: true;

    if root.items.length == 0 : VerticalLayout {
        alignment: center;
        spacing: 10px;
        Icon { name: "search"; size: 40px; tint: Theme.text-muted; x: (root.width - 40px) / 2; }
        Text {
            text: root.empty-text != "" ? root.empty-text : (root.query == "" ? "暂无最近使用记录" : "未找到匹配「" + root.query + "」的项目");
            font-size: 13px;
            color: Theme.text-tertiary;
            horizontal-alignment: center;
        }
        Text {
            text: root.query == "" ? "输入关键词开始搜索应用、文件与剪贴板" : "尝试切换分类标签，或按 Tab 切换至 ✦ 智能搜索模式";
            font-size: 11px;
            color: Theme.text-muted;
            horizontal-alignment: center;
        }
    }

    // ------------------------------ 列表视图 ------------------------------
    list := ListView {
        visible: root.view-mode != "grid" && root.items.length > 0;
        // 设计稿 .search-result-pane { padding: 4px 16px 8px 16px }
        //   横向 16px 由 x/width 承担，纵向 4/8 折进 y/height（ListView 不能设 padding）
        x: 16px;
        width: root.width - 32px;
        y: 4px;
        height: root.height - 12px;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        for row in root.rows : Rectangle {
            // 设计稿 .section-header { padding: 8px 0 4px 0; line-height: 1 } → 23px
            //          .search-item  { height: 42px; margin: 1px -6px } → 行距 44px
            height: row.is-header ? 23px : 44px;
            if row.is-header : Text {
                x: 0px;
                text: row.header;
                // 设计稿 .section-header { padding: 8px 0 4px 0; line-height: 1; font-size: 11px }
                // → 行盒就是 11px 高，墨迹中心落在 header 顶边 +8 +5.5 = 13.5。
                // ⚠️ 不钉 height 的话 Slint 用**自然行高**（11px 文本 ≈16.5px），
                //    墨迹中心变成 +16.25 → 段标题比设计稿低 2.75px（实测
                //    设计稿 230.5 / 原生 233.3）。这是「CSS line-height:1 ↔ Slint
                //    自然行高」这一族差异的第 3 处（另两处见 §13.5 / §14.5）。
                // ⚠️ 网格视图的段标题在下方 `sec.title` 里是**另一份实现**，
                //    两处必须同时改，否则只有一种视图对齐（见 §15.2）。
                font-size: 11px;
                font-weight: 600;
                // 设计稿 .section-header { color: rgba(255,255,255,0.45); letter-spacing: 0.06em }
                color: Theme.dark ? #ffffff73 : #00000073;
                letter-spacing: 0.66px;
                y: 8px;
                height: 11px;
                vertical-alignment: center;
            }
            if !row.is-header : Rectangle {
                x: -6px;
                width: parent.width + 12px;
                // 设计稿 .search-item 的 margin 1px 上下 → 44px 槽位里 42px 高亮
                y: 1px;
                height: 42px;
                border-radius: 8px;
                background: root.selected == row.index ? Theme.selected : (rta.has-hover ? Theme.hover : transparent);
                // 设计稿 .search-item.selected { box-shadow: inset 0 0 0 1px rgba(255,255,255,0.08) }
                border-width: root.selected == row.index ? 1px : 0px;
                border-color: Theme.dark ? #ffffff14 : #00000014;
                animate background { duration: Theme.fast; }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 12px;
                    Squircle { icon: row.item.icon; size: 28px; y: 7px; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: row.item.title;
                            font-size: 13px;
                            font-weight: 500;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            overflow: elide;
                            max-width: 300px;
                        }
                        Badge { text: row.item.badge; y: 12px; }
                    }
                    Text {
                        text: root.smart && row.item.reason != "" ? row.item.reason : row.item.subtitle;
                        font-size: 11px;
                        font-family: root.smart ? Theme.font : Theme.mono;
                        // 对齐设计稿 .item-path-col：
                        //   常态 rgba(255,255,255,0.4)，悬停/选中 rgba(255,255,255,0.65)
                        //   智能模式下的 reason 用紫色高亮以示语义来源
                        color: root.smart
                            ? #c4b5fd
                            : ((root.selected == row.index || rta.has-hover)
                                ? (Theme.dark ? #ffffffa6 : #000000a6)
                                : (Theme.dark ? #ffffff66 : #00000066));
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    // 行内动作提示（对齐设计稿 .item-action-col）：
                    //   常态：10px / text-muted / opacity 0.5 / padding 1px 5px / radius 3px / 无底色
                    //   选中：opacity 1 / #93c5fd / 底色 rgba(59,130,246,0.18)
                    // 注意：设计稿的「3D 机械质感键帽」属于**右键菜单**（已由
                    // context_menu.slint 的 MenuItemRow 实现），结果行这里是低调的文字胶囊。
                    if row.item.action != "" : Rectangle {
                        width: act.preferred-width + 10px;
                        height: 16px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 3px;
                        background: root.selected == row.index ? #3b82f62e : transparent;
                        act := Text {
                            text: row.item.action;
                            font-size: 10px;
                            color: root.selected == row.index ? #93c5fd : Theme.text-muted;
                            opacity: root.selected == row.index ? 1 : 0.5;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }
                    }
                }
                rta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.select(row.index); }
                    double-clicked => { if (root.dbl-launch) { root.activate(row.index); } }
                    pointer-event(ev) => {
                        if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                            root.select(row.index);
                            root.context(row.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                }
            }
        }
    }

    // ------------------------------ 图标网格视图 ------------------------------
    grid := ScrollView {
        visible: root.view-mode == "grid" && root.items.length > 0;
        x: 16px;
        width: root.width - 32px;
        y: 4px;
        height: root.height - 12px;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        content-width: self.visible-width;
        VerticalLayout {
            width: grid.visible-width;
            spacing: 0px;
            alignment: start;
            for sec in root.sections : VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 23px;
                    Text {
                        x: 0px;
                        text: sec.title;
                        // 设计稿 .section-header { padding: 8px 0 4px 0; line-height: 1; font-size: 11px }
                        // → 行盒就是 11px 高，墨迹中心落在 header 顶边 +8 +5.5 = 13.5。
                        // ⚠️ 不钉 height 的话 Slint 用**自然行高**（11px 文本 ≈16.5px），
                        //    墨迹中心变成 +16.25 → 整个段标题比设计稿低 2.75px（实测
                        //    设计稿 230.5 / 原生 233.35）。这是「CSS line-height:1 ↔ Slint
                        //    自然行高」这一族差异的第 3 处（另两处见 §13.5 / §14.5）。
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.dark ? #ffffff73 : #00000073;
                        letter-spacing: 0.66px;
                        y: 8px;
                        height: 11px;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    // 设计稿 .items-icon-grid { padding: 6px 0 14px 0 } → 卡片区上下各留 6 / 14
                    height: Math.ceil(sec.count / root.grid-cols) * root.cell-height + 20px;
                    // ⚠️ 槽位宽必须**含** gap：设计稿是 6 列 131.33 + 5×8 = 828，
                    //    列距 139.33。若按 828/6 = 138 当槽位，卡片只有 130 宽、列距 138，
                    //    比设计稿窄 1.33px（实测列距 138.0 vs 139.0）。
                    property <length> cell-w: (grid.visible-width + 8px) / root.grid-cols;
                    for j in sec.count : Rectangle {
                        property <int> idx: sec.start + j;
                        x: Math.mod(j, root.grid-cols) * parent.cell-w;
                        y: Math.floor(j / root.grid-cols) * root.cell-height + 6px;
                        width: parent.cell-w;
                        height: root.cell-height;
                        Rectangle {
                            // 设计稿：卡片**就是**网格行（行高 98），行与行之间才是 gap 8px。
                            //   所以卡片顶边贴槽位顶边，8px 全部留在下面（原先 y:4 让首行低 4px）。
                            // ⚠️ 横向同理：`grid-template-columns: repeat(auto-fill, minmax(115px,1fr))`
                            //   的 gap 是**列与列之间**，第一列左边紧贴容器内容左边缘、最后一列
                            //   右边紧贴右边缘（6×131.33 + 5×8 = 828 = 内容宽，两端都齐）。
                            //   原先写 x:4px 是把 8px 拆成左右各 4 → 整个网格右移 4px，
                            //   末列右边缘还溢出容器 4px（实测卡左 20.0 vs 设计稿 16.0）。
                            x: 0px;
                            y: 0px;
                            width: parent.width - 8px;
                            height: parent.height - 8px;
                            border-radius: 6px;
                            // 设计稿 .icon-card-item.selected { background: rgba(255,255,255,0.12); box-shadow: 0 0 0 1px rgba(255,255,255,0.18) }
                            background: root.selected == idx
                                ? (Theme.dark ? #ffffff1f : #0000000f)
                                : (gta.has-hover ? Theme.hover : transparent);
                            border-width: root.selected == idx ? 1px : 0px;
                            border-color: Theme.dark ? #ffffff2e : #0000002e;
                            animate background { duration: Theme.fast; }
                            VerticalLayout {
                                padding-top: 12px;
                                // 设计稿 .icon-card-item { padding: 12px 6px 10px 6px }
                                padding-bottom: 10px;
                                padding-left: 6px;
                                padding-right: 6px;
                                // 设计稿卡内三段间距**各不相同**：
                                //   .icon-card-glyph { height:36px; margin-bottom:6px }
                                //   .icon-card-title { line-height:16px }
                                //   .icon-card-badge { margin-top:4px; line-height:12px; padding:1px 5px }
                                //   → 卡内 12 + 36 + 6 + 16 + 4 + 14 = 88，+ padding-bottom 10 = 98 ✅
                                // Slint 的 VerticalLayout 只有一个 spacing，只能凑等价解：
                                //   这里 squircle 是 38px（设计稿也是 38px，只是塞在 36px 槽位里、
                                //   上下各溢出 1px），所以它比设计稿多占 2px 布局高度。
                                //   取 spacing 4 → title 顶边 = 12+38+4 = 54（设计稿 12+36+6 = 54 ✅）
                                //                  badge 顶边 = 54+16+4 = 74（设计稿 54+16+4 = 74 ✅）
                                //   实测（相对卡顶）：title 中心 63.7 vs 62.0、badge 84.7 vs 82.0
                                //   —— 都在 2px 内；改前是 +5.0 / +8.3。
                                spacing: 4px;
                                alignment: start;
                                // 🔴 图标必须**自己**用居中布局摆，不能写
                                //    `x: (parent.width - 38px) / 2`：在 VerticalLayout 的子级里
                                //    `parent.width` 解析不到卡片可用宽（实测解析成 ~38px →
                                //    x≈0），图标会被顶到卡片左内边距上。
                                //    实测首列图标中心 45.0 vs 设计稿 83.5，整整差一列内边距。
                                HorizontalLayout {
                                    alignment: center;
                                    Squircle { icon: root.items[idx].icon; size: 38px; }
                                }
                                Text {
                                    text: root.items[idx].title;
                                    // 设计稿 .icon-card-title { font-size: 11.5px; line-height: 16px }
                                    font-size: 11.5px;
                                    font-weight: 500;
                                    // ⚠️ 必须钉死 16px：Slint 里 11.5px 文本的自然行高 ≈17.5，
                                    //    多出的 1.5px 会把下面的徽标一起推低。
                                    height: 16px;
                                    color: Theme.text-primary;
                                    horizontal-alignment: center;
                                    overflow: elide;
                                }
                                // 设计稿 .icon-card-badge：9.5px / text-tertiary /
                                //   bg rgba(255,255,255,0.06) / padding 1px 5px / radius 3px
                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 14px;
                                        width: bt.preferred-width + 10px;
                                        border-radius: 3px;
                                        background: Theme.dark ? #ffffff0f : #0000000f;
                                        bt := Text {
                                            text: root.items[idx].badge;
                                            font-size: 9.5px;
                                            color: Theme.text-tertiary;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                            width: parent.width;
                                            height: parent.height;
                                        }
                                    }
                                }
                            }
                            gta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.select(idx); }
                                double-clicked => { if (root.dbl-launch) { root.activate(idx); } }
                                pointer-event(ev) => {
                                    if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                                        root.select(idx);
                                        root.context(idx, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
