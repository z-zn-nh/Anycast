// 置顶展架：固定 86×84 图标卡片，单行横向轨道，鼠标滚轮横向滚动，0 抖动折叠
import { Theme } from "../styles/tokens.slint";
import { Icon, Squircle, Badge } from "widgets.slint";
import { ResultItem } from "types.slint";

export component PinnedShelf inherits Rectangle {
    in property <[ResultItem]> items;
    in-out property <bool> collapsed: false;
    in property <int> selected: -1;
    // 同 ResultPane.dbl-launch：由设置页「双击条目立即执行」驱动
    in property <bool> dbl-launch: true;
    callback toggle();
    callback select(int);
    callback activate(int);
    callback context(int, length, length);

    property <length> min-x: Math.min(0px, fl.width - fl.content-width);
    // 对齐设计稿 .pinned-shelf-section 的盒模型（Slint 没有 margin，等效量折进高度）：
    //   padding-top 4 + header 20 + header margin-bottom 6
    //   + .pinned-track-wrapper(2 + 84 + 6 = 92) + padding-bottom 4  = 126
    //   + margin-bottom 2 = 128
    // 折叠态 = 4 + 20 + 4 = 28，同样 +2 等效 margin。
    // ⚠️ 此前是 28 + 94 = 122，整整少了 6px → 分类栏/结果区整体上浮，
    //    与设计稿累积偏差 5~6px（实测分类胶囊顶 173.4 vs 设计 180）。
    height: (collapsed ? 28px : 126px) + 2px;
    animate height { duration: 220ms; easing: Theme.ease; }
    clip: true;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 4px;
        spacing: 0px;
        // 标题行（刚性 20px，折叠展开绝对 0 位移）
        Rectangle {
            height: 20px;
            HorizontalLayout {
                spacing: 6px;
                Icon { name: "pin"; size: 12px; tint: Theme.text-soft; y: 4px; }
                Text {
                    text: "置顶";
                    // 设计稿 .pinned-shelf-header { font-size: 11.5px; font-weight: 600; color: rgba(255,255,255,0.9) }
                    font-size: 11.5px;
                    font-weight: 600;
                    color: Theme.dark ? #ffffffe6 : #000000e6;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 20px;
                    height: 20px;
                    background: transparent;
                    Icon {
                        name: root.collapsed ? "chevronDown" : "chevronUp";
                        size: 12px;
                        tint: tta.has-hover ? Theme.text-primary : Theme.text-soft;
                        x: 4px;
                        y: 4px;
                    }
                    tta := TouchArea { mouse-cursor: pointer; clicked => { root.toggle(); } }
                }
            }
        }
        Rectangle {
            // 设计稿 .pinned-track-wrapper：2(padding-top) + 84(card) + 6(padding-bottom) = 92，
            // 这里取 98 是因为下面的 HorizontalLayout 用 y:8px 顶到「header margin 6 + track padding 2」
            // 之后还要留出 track 的 6px padding-bottom。多出的部分透明，不参与视觉。
            height: root.collapsed ? 0px : 98px;
            opacity: root.collapsed ? 0 : 1;
            animate height { duration: 220ms; easing: Theme.ease; }
            animate opacity { duration: 180ms; easing: Theme.ease; }
            clip: true;
            // 空状态：优雅虚线槽，垂直居中，替代此前生硬贴顶的大灰字
            if root.items.length == 0 : Rectangle {
                height: 84px;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border-subtle;
                background: transparent;
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    Icon { name: "plus"; size: 13px; tint: Theme.text-muted; }
                    Text {
                        text: "右键任意条目选择「固定到置顶」，或按 Ctrl+P";
                        font-size: 11px;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                }
            }
            wheel := TouchArea {
                scroll-event(ev) => {
                    fl.content-x = Math.max(root.min-x, Math.min(0px, fl.content-x - ev.delta-y - ev.delta-x));
                    return accept;
                }
                fl := Flickable {
                    interactive: false;
                    content-width: Math.max(self.width, root.items.length * 94px);
                    content-height: 98px;
                    HorizontalLayout {
                        // 设计稿：header 的 margin-bottom 6 + track-wrapper 的 padding-top 2 = 8px
                        // 才是第一张卡的顶边。此前写 4px → 卡片整体上移 4px。
                        y: 8px;
                        // 设计稿 .pinned-track-wrapper { padding: 2px 2px 6px 2px } —— 横向那 2px
                        // 是**轨道自己**的 padding（section 的 16px 之外再缩 2px），
                        // 所以首卡左边缘在 18 而不是 16。此前漏了 → 整个置顶架左移 2~3px
                        // （实测首卡图标中心 59.0 vs 设计稿 62.0）。
                        // ⚠️ 只加左，不加右：右侧 2px 是滚动区尾部的留白，加进去会让
                        //    content-width 与末卡右边缘对不上。
                        x: 2px;
                        spacing: 8px;
                        alignment: start;
                        for item[i] in root.items : Rectangle {
                            width: 86px;
                            height: 84px;
                            border-radius: 6px;
                            background: root.selected == i ? Theme.selected : (cta.has-hover ? Theme.hover : transparent);
                            animate background { duration: Theme.fast; }
                            VerticalLayout {
                                // 设计稿 .pinned-card { padding: 8px 4px 6px 4px }
                                padding-top: 8px;
                                padding-bottom: 6px;
                                // 设计稿卡内三段间距**各不相同**：
                                //   .pinned-card-glyph { height:34px; margin-bottom:5px }
                                //   .pinned-card-title { line-height:15px }
                                //   .pinned-card-badge { margin-top:3px; line-height:12px; padding:1px 5px }
                                //   → 8 + 34 + 5 + 15 + 3 + 14 = 79，+ padding-bottom 6 = 85（卡高 84，溢出 1px）
                                // Slint 的 VerticalLayout 只有一个 spacing，取 3（= title→badge 的 3）：
                                //   为了让 glyph→title 仍是 5，把 34px 的 squircle 装进 36px 的槽位
                                //   （squircle 自己 y:1 → 上下各留 1px，视觉位置不变）。
                                //   于是 title 顶边 = 8+36+3 = 47、badge 顶边 = 47+15+3 = 65，
                                //   与设计稿的 8+34+5 = 47 / 47+15+3 = 65 逐值相等。
                                spacing: 3px;
                                alignment: start;
                                Rectangle {
                                    height: 36px;
                                    Squircle { icon: item.icon; size: 34px; x: (86px - 34px) / 2; y: 1px; }
                                }
                                Text {
                                    text: item.title;
                                    // 设计稿 .pinned-card-title { font-size: 11.5px; font-weight: 500;
                                    //   line-height: 15px; text-shadow: 0 1px 2px rgba(0,0,0,0.4) }
                                    // 注：Slint 无 text-shadow，该项属渲染后端能力差距，见 6.7。
                                    font-size: 11.5px;
                                    font-weight: 500;
                                    color: Theme.text-primary;
                                    horizontal-alignment: center;
                                    overflow: elide;
                                    width: 78px;
                                    x: 4px;
                                    // ⚠️ 必须钉死行高。Slint 里 11.5px 文本的自然行高 ≈17.5px，
                                    //    比设计稿的 line-height 15px 高 2.5px → 下面那颗徽标
                                    //    被整体推低（实测徽标中心 159 vs 设计稿 156）。
                                    //    VerticalLayout 的子元素**不能写 y**（Slint 报
                                    //    「The property 'y' cannot be set for elements placed in
                                    //    this layout」），所以只能从行高这一侧收回来。
                                    height: 15px;
                                }
                                // 设计稿 .pinned-card-badge：9.5px / text-tertiary /
                                //   bg rgba(255,255,255,0.06) / padding 1px 5px / radius 3px / margin-top 3px
                                // 此前实现成了裸文本（无胶囊底），与设计稿观感差异明显。
                                Rectangle {
                                    height: 14px;
                                    width: bdg.preferred-width + 10px;
                                    x: (86px - self.width) / 2;
                                    border-radius: 3px;
                                    background: Theme.dark ? #ffffff0f : #0000000f;
                                    bdg := Text {
                                        text: item.badge;
                                        font-size: 9.5px;
                                        color: Theme.text-tertiary;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                }
                            }
                            cta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.select(i); }
                                double-clicked => { if (root.dbl-launch) { root.activate(i); } }
                                pointer-event(ev) => {
                                    if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                                        root.context(i, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
